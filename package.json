{
  "name": "@lvce-editor/renderer-worker-worker-monorepo",
  "version": "0.0.0-dev",
  "description": "",
  "license": "MIT",
  "author": "Lvce Editor",
  "type": "module",
  "main": "",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/build/src/build.js",
    "build:static": "node packages/build/src/build-static.js",
    "build:watch": "./packages/build/node_modules/.bin/esbuild --format=esm --bundle --external:node:buffer --external:electron --external:ws --external:node:worker_threads --watch packages/renderer-worker/src/rendererWorkerMain.ts --outfile=.tmp/dist/dist/rendererWorkerMain.js",
    "dev": "node packages/build/src/dev.js",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "npm test --workspaces --if-present",
    "test-integration": "npm run test-integration --workspaces --if-present",
    "type-check": "tsc -b"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 150
  },
  "devDependencies": {
    "@lvce-editor/eslint-config": "^17.6.0",
    "eslint": "^10.8.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.0"
  }
}
